{
  "name": "dsh-connect-loomy",
  "displayName": "DSH Connect Loomy",
  "description": "把本机已登录的 Loomy（讯飞）账号接入 DeepSeek Harness：OpenAI 兼容对话模型（含 reasoning 思考链与结构化工具调用透传）、只读积分额度看板（总余额 / 每日额度 / 可用余额）。复用 Loomy 桌面端本机登录态，不复制、不存储凭据；仅 Windows x64。",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxgh776/dsh-connect-loomy.git"
  },
  "homepage": "https://github.com/hxgh776/dsh-connect-loomy#readme",
  "bugs": {
    "url": "https://github.com/hxgh776/dsh-connect-loomy/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "loomy",
    "iflytek",
    "spark",
    "model-provider",
    "quota"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-connect-loomy": "lib/bin.js",
    "dsh-connect-loomy-probe": "lib/cli-probe.js",
    "dsh-connect-loomy-doctor": "lib/cli-doctor.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "probe": "node lib/cli-probe.js",
    "doctor": "node lib/cli-doctor.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "prepack": "npm run typecheck && node scripts/check-syntax.mjs && node scripts/check-contract.mjs",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <4.1.0-0 || >=4.1.0-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <3.19.0-0 || >=3.19.0-rc.1 <4.0.0-0",
    "@earendil-works/pi-ai": ">=0.85.0-rc.1 <0.86.0-0 || >=0.86.0-rc.1 <0.87.0-0 || >=0.87.0-rc.1 <1.0.0-0 || >=1.0.0-rc.1 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@earendil-works/pi-ai": ">=1.0.2 <2.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.9.3"
  }
}
